<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="fittrack.exe"
        Arguments=""
        InstallLocation="C:\Program Files\FitTrack\FitTrack">
    </Installer>
    <PackageInformation
        PackageName="FitTrack"
        PackageDisplayName="FitTrack"
        PublisherName="CN=FitTrack"
        PublisherDisplayName="FitTrack"
        Version="0.1.0.0"
        PackageDescription="Offline fitness tracking">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.vanam.fittrack"
                Description="Offline fitness tracking"
                DisplayName="FitTrack"
                ExecutableName="fittrack.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>FitTrack</DisplayName>
            <PublisherDisplayName>FitTrack</PublisherDisplayName>
            <Description>Offline fitness tracking</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="fittrack.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
